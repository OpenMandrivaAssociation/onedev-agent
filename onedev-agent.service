[Unit]
Description=OneDev build agent/executor
After=network-online.target
Wants=network-online.target

[Service]
User=onedev-agent
Group=onedev-agent
WorkingDirectory=/srv/onedev-agent
ExecStart=/usr/bin/onedev-agent
Restart=always
RestartSec=5
Environment=JAVA_HOME=/usr/lib/jvm/jre
Environment=ONDEV_AGENT_HOME=/var/lib/onedev-agent

# Hardening (optional but recommended)
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
